# --- Database ---
# SQLite (development, default — zero setup required)
DATABASE_URL=sqlite:///./aims.db

# PostgreSQL (production) - uncomment and fill in when deploying
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aims

# --- JWT ---
# IMPORTANT: Change this to a long, random string before deploying.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256

# --- Credential / Agent lifecycle policy ---
# Days of inactivity before an agent is flagged "stale"
STALE_THRESHOLD_DAYS=30
# Days of inactivity before a stale agent is auto-revoked
AUTO_REVOKE_THRESHOLD_DAYS=90
# Default credential lifetime in days (issued at registration / rotation)
CREDENTIAL_LIFETIME_DAYS=90

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# In dev, Vite runs on 5173 and CRA on 3000.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Application mode ---
# Set DEBUG=false in production. The app will refuse to start with the
# default JWT_SECRET_KEY when DEBUG=false.
DEBUG=true

# --- Auth0 OIDC (bonus feature, optional) ---
# Set AUTH0_ENABLED=true and fill in the values below to require Auth0
# JWT verification for human/admin dashboard access.
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
AUTH0_ISSUER=
AUTH0_ENABLED=false
